<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- BenchmarkDotNet requires an optimized build; guard against running it in Debug by mistake. -->
    <AssemblyName>YetAnotherHttpHandler.Benchmark</AssemblyName>
    <!-- Not *.YetAnotherHttpHandler.*: a namespace by that name would shadow the handler type. -->
    <RootNamespace>YahaBenchmark</RootNamespace>
    <ServerGarbageCollector>true</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- The benchmark hosts Kestrel in-process so the server is a constant across both handlers. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\YetAnotherHttpHandler\YetAnotherHttpHandler.csproj" />
  </ItemGroup>

  <!-- Reuse the test server's self-signed localhost certificate for the TLS scenarios. -->
  <ItemGroup>
    <None Include="..\..\external\HttpClientTestServer\src\certs\localhost.pfx" LinkBase="Certificates">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
